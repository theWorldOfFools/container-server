APP_NAME="Container Server"
APP_URL=http://localhost/container-server/public
WS_URL=ws://localhost:6789

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=container_server
DB_USERNAME=container_app
DB_PASSWORD=changeme

DOCKER_SOCKET=/var/run/docker.sock
DOCKER_API_VERSION=v1.53

WS_PORT=6789
WS_HOST=127.0.0.1
# Token WS divalidasi ke PG, tidak perlu secret tambahan.
# Kosongkan = izinkanพัฒนาต่อ; isi = wajib cocok dengan header signature (opsional).
WS_SHARED_SECRET=

# Batasan default user baru
DEFAULT_MAX_CONTAINERS=5
DEFAULT_MAX_MEMORY_MB=2048

# Whitelist image (koma) + port range untuk create container
ALLOWED_IMAGES=nginx:latest,php:8.2-apache,mysql:8,redis:7,node:20,postgres:16
PORT_RANGE_MIN=8000
PORT_RANGE_MAX=9000
